################### Command Word #2 (Register 0x0001) - Current Setpoint ####################
# Scaling measured on DHPTB101 (2026-10-22) against the real output current,
# raw 1000..20000: I[A] = CURR_ESLO * raw + CURR_EOFF. The PS display reads
# ~20% lower than the real current (display = 0.0075638 * raw).

record(ao, "$(P):$(R):CURR_SET")
{
    field(DESC, "Current Setpoint")
    field(EGU,  "A")
    field(PREC, "3")
    field(LINR, "SLOPE")
    field(ESLO, "$(CURR_ESLO=0.009094)")
    field(EOFF, "$(CURR_EOFF=-0.475)")
    field(DRVH, "$(MAX_CURR=330)")
    field(DRVL, "$(MIN_CURR=0)")
    field(HOPR, "$(MAX_CURR=330)")
    field(LOPR, "$(MIN_CURR=0)")
    field(FLNK, "$(P):$(R):CMD_FRAME_CALC")
}

################### Command Area frame (Registers 0x0000-0x0001) ####################

record(calc, "$(P):$(R):CMD_WORD")
{
    field(DESC, "Command word")
    field(INPA, "$(P):$(R):CMD_STANDBY NPP")
    field(INPB, "$(P):$(R):CMD_ON NPP")
    field(INPC, "$(P):$(R):CMD_OFF NPP")
    field(INPD, "$(P):$(R):CMD_RESET NPP")
    field(INPE, "$(P):$(R):CMD_START_RAMP NPP")
    field(INPF, "$(P):$(R):CMD_MODE_DC NPP")
    field(INPG, "$(P):$(R):CMD_MODE_PULSED NPP")
    field(INPH, "$(P):$(R):CMD_POLA_POSITIVE NPP")
    field(INPI, "$(P):$(R):CMD_POLA_NEGATIVE NPP")
    field(CALC, "A+2*B+4*C+8*D+16*E+32*F+64*G+128*H+256*I")
    field(FLNK, "$(P):$(R):CMD_FRAME_CALC")
}

record(aSub, "$(P):$(R):CMD_FRAME_CALC")
{
    field(DESC, "Pack command area")
    field(SNAM, "maccaferriFrame")
    field(INPA, "$(P):$(R):CMD_WORD NPP")
    field(FTA,  "LONG")
    field(INPB, "$(P):$(R):CURR_SET.RVAL NPP")
    field(FTB,  "LONG")
    field(FTVA, "LONG")
    field(NOVA, "2")
    field(OUTA, "$(P):$(R):CMD_FRAME PP")
}

record(waveform, "$(P):$(R):CMD_FRAME")
{
    field(DESC, "Command area 0x0000-0x0001")
    field(DTYP, "asynInt32ArrayOut")
    field(INP,  "@asyn($(PORT_CMD_WO) 0 $(TIMEOUT=1000))MODBUS_DATA")
    field(FTVL, "LONG")
    field(NELM, "2")
}

