################### Fast Readbacks (40ms poll - 25Hz) - Registers 0x0023-0x0026 ####################
# Current reference readback (echo of 0x0001, same scaling as CURR_SET)
record(ai, "$(P):$(R):CURR_RB")
{
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORTFAST) 0 $(TIMEOUT=1000))MODBUS_DATA")
    field(DESC, "Current Reference Readback")
    field(EGU,  "A")
    field(PREC, "3")
    field(SCAN, "I/O Intr")
    field(ASLO, "$(CURR_ESLO=0.009094)")
    field(AOFF, "$(CURR_EOFF=-0.475)")
}

# Output current readback (measured: raw 10154 at 181.4 A real, ~11 at 0 A)
record(ai, "$(P):$(R):OUTPUT_CURRENT_RB")
{
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORTFAST) 1 $(TIMEOUT=1000))MODBUS_DATA")
    field(DESC, "Output Current Readback")
    field(EGU,  "A")
    field(PREC, "3")
    field(SCAN, "I/O Intr")
    field(ASLO, "$(IOUT_ASLO=0.017884)")
    field(AOFF, "$(IOUT_AOFF=-0.197)")
}

