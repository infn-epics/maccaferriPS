# Maccaferri Power Supply UNIMAG Interface
# Provides simplified signed current control with automatic polarity switching
# Requires maccaferriPS_main.template to be loaded first
# Logic implemented in maccaferriControl.st (SNL state program)
#
# STATE_SP (aligned across the UNIMAG power-supply IOCs):
#   0 OFF | 1 ON | 2 STANDBY | 3 RESET
# STATE_RB (aligned across the UNIMAG power-supply IOCs):
#   0 OFF | 1 ON | 2 STANDBY | 3 FAULT (MAJOR) | 4 EXT_INTLK (MAJOR)
#   5 CONN_FAULT (MAJOR, communication errors)
#   6 SP_NOT_REACHED (MINOR, current setpoint not reached)
#   7 ST_NOT_REACHED (MAJOR, commanded state not reached)
#
# Macros:
#   P, R            PV prefix
#   MAX_CURR, MIN_CURR  (A) CURRENT_SP limits
#   SET_TOLERANCE   (A) readback within this of CURRENT_SP counts as reached
#                       (default 1.0, 0 disables the setpoint check)
#   ZERO_TOLERANCE  (A) a zero setpoint counts as reached within this
#                       (default 0.5)
#   SET_TIMEOUT_S   (s) how long the setpoint / state may stay unreached
#                       without progress before it is reported (default 30)

################### UNIMAG Current Setpoint ####################
# User sets current in A (positive or negative)
# Monitored by SNL program for automatic sequencing and polarity control

record(ao, "$(P):$(R):CURRENT_SP")
{
    field(DESC, "Current Setpoint (signed, A)")
    field(EGU,  "A")
    field(PREC, "3")
    field(DRVH, "$(MAX_CURR=330)")
    field(DRVL, "$(MIN_CURR=-330)")
    field(HOPR, "$(MAX_CURR=330)")
    field(LOPR, "$(MIN_CURR=-330)")
}

################### Current Readback (Signed) ####################
# Combine absolute current readback with polarity to create signed value
record(calcout, "$(P):$(R):CURRENT_RB")
{
    field(DESC, "Current Readback (signed, A)")
    field(INPA, "$(P):$(R):CURR_RB CP")
    field(INPB, "$(P):$(R):STAT_POLA_POSITIVE CP")
    field(CALC, "B?A:(-A)")
    field(EGU,  "A")
    field(PREC, "3")
}

################### UNIMAG state ####################
# CONN_FAULT when the status word (0x0022) cannot be read, EXT_INTLK on
# external interlock 1/2 (0x0021 bits 4/5), FAULT on the PS fault sum, then
# ON / STANDBY from the state bits; neither set reads OFF.

record(calcout, "$(P):$(R):STATE_RB_CALC")
{
    field(DESC, "State readback")
    field(INPA, "$(P):$(R):STAT_POWER_ON CP")
    field(INPB, "$(P):$(R):STAT_STANDBY CP")
    field(INPC, "$(P):$(R):STAT_FAULTY CP")
    field(INPD, "$(P):$(R):STAT_POWER_ON.SEVR CP NMS")
    field(INPE, "$(P):$(R):STAT_EXT_INTLK1 CP")
    field(INPF, "$(P):$(R):STAT_EXT_INTLK2 CP")
    field(CALC, "D>=3?5:((E||F)?4:(C?3:(A?1:(B?2:0))))")
    field(OUT,  "$(P):$(R):STATE_BASE PP")
    field(OOPT, "Every Time")
}

record(mbbo, "$(P):$(R):STATE_SP")
{
    field(DESC, "State setpoint")
    field(ZRVL, "0")
    field(ZRST, "OFF")
    field(ONVL, "1")
    field(ONST, "ON")
    field(TWVL, "2")
    field(TWST, "STANDBY")
    field(THVL, "3")
    field(THST, "RESET")
    field(FLNK, "$(P):$(R):ON_CANCEL")
}

# Any command other than ON drops a pending ON
record(calcout, "$(P):$(R):ON_CANCEL")
{
    field(DESC, "Cancel pending ON")
    field(INPA, "$(P):$(R):STATE_SP NPP")
    field(CALC, "A!=1")
    field(OOPT, "When Non-zero")
    field(DOPT, "Use OCAL")
    field(OCAL, "0")
    field(OUT,  "$(P):$(R):ON_PENDING PP")
    field(FLNK, "$(P):$(R):STATE_DISPATCH")
}

# OFF -> Off, ON -> see ON_REQ, STANDBY -> Standby, RESET -> Reset
record(seq, "$(P):$(R):STATE_DISPATCH")
{
    field(DESC, "State command dispatcher")
    field(SELM, "Specified")
    field(SELL, "$(P):$(R):STATE_SP NPP")
    field(DOL0, "1")
    field(LNK0, "$(P):$(R):CMD_OFF PP")
    field(DOL1, "1")
    field(LNK1, "$(P):$(R):ON_REQ.PROC PP")
    field(DOL2, "1")
    field(LNK2, "$(P):$(R):CMD_STANDBY PP")
    field(DOL3, "1")
    field(LNK3, "$(P):$(R):CMD_RESET PP")
}

# On is only accepted in STANDBY. From STANDBY send On now; from OFF send
# Standby first and On once the standby bit is set (ON_PENDING meanwhile).
# Already ON, faulty or unreachable: nothing is sent.
record(calcout, "$(P):$(R):ON_REQ")
{
    field(DESC, "ON request")
    field(INPA, "$(P):$(R):STATE_BASE NPP NMS")
    field(CALC, "A=2?1:(A=0?6:0)")
    field(OUT,  "$(P):$(R):ON_ACTION.SELN PP")
    field(OOPT, "Every Time")
}

# SELN bit mask: 1 On, 2 set ON_PENDING, 4 Standby
record(seq, "$(P):$(R):ON_ACTION")
{
    field(DESC, "ON actions")
    field(SELM, "Mask")
    field(SHFT, "0")
    field(DOL0, "1")
    field(LNK0, "$(P):$(R):CMD_ON PP")
    field(DOL1, "1")
    field(LNK1, "$(P):$(R):ON_PENDING PP")
    field(DOL2, "1")
    field(LNK2, "$(P):$(R):CMD_STANDBY PP")
}

record(bo, "$(P):$(R):ON_PENDING")
{
    field(DESC, "ON waits for standby")
    field(ZNAM, "NO")
    field(ONAM, "WAITING")
}

# Standby reached with ON pending: send On
record(calcout, "$(P):$(R):ON_PENDING_GO")
{
    field(DESC, "Standby reached, send On")
    field(INPA, "$(P):$(R):STATE_BASE CP")
    field(INPB, "$(P):$(R):ON_PENDING CP")
    field(CALC, "B&&A=2")
    field(OOPT, "When Non-zero")
    field(OUT,  "$(P):$(R):ON_PENDING_ACT.PROC PP")
}

record(seq, "$(P):$(R):ON_PENDING_ACT")
{
    field(DESC, "Clear pending and send On")
    field(DOL0, "0")
    field(LNK0, "$(P):$(R):ON_PENDING PP")
    field(DOL1, "1")
    field(LNK1, "$(P):$(R):CMD_ON PP")
}

# PS went faulty or unreachable: drop the pending ON
record(calcout, "$(P):$(R):ON_PENDING_ABORT")
{
    field(DESC, "Fault, drop pending ON")
    field(INPA, "$(P):$(R):STATE_BASE CP")
    field(INPB, "$(P):$(R):ON_PENDING CP")
    field(CALC, "B&&A>=3")
    field(OOPT, "When Non-zero")
    field(DOPT, "Use OCAL")
    field(OCAL, "0")
    field(OUT,  "$(P):$(R):ON_PENDING PP")
}

################### Interlock Status ####################
record(calc, "$(P):$(R):INTERLOCKED")
{
    field(DESC, "Interlock Active (Fault)")
    field(INPA, "$(P):$(R):STATE_BASE CP")
    field(CALC, "A=3||A=4")
}

################### UNIMAG state readback and watchdogs ####################
# Same records as the other UNIMAG IOCs (hazemeyer-citbus
# hzacc_unimag_state.template / hzacc_unimag_setpoint.template)

record(ao, "$(P):$(R):SET_TIMEOUT_S")
{
    field(DESC, "Setpoint/state timeout")
    field(EGU,  "s")
    field(PREC, "1")
    field(VAL,  "$(SET_TIMEOUT_S=30)")
    field(PINI, "YES")
    field(DRVL, "1")
    field(DRVH, "3600")
}

record(ao, "$(P):$(R):SET_TOLERANCE")
{
    field(DESC, "Current setpoint tolerance")
    field(EGU,  "A")
    field(PREC, "3")
    field(VAL,  "$(SET_TOLERANCE=1.0)")
    field(PINI, "YES")
    field(DRVL, "0")
    field(DRVH, "1000")
}

record(ao, "$(P):$(R):ZERO_TOLERANCE")
{
    field(DESC, "Zero current tolerance")
    field(EGU,  "A")
    field(PREC, "3")
    field(VAL,  "$(ZERO_TOLERANCE=0.5)")
    field(PINI, "YES")
    field(DRVL, "0")
    field(DRVH, "1000")
}

# Plain decoded state (0-5), written by STATE_RB_CALC
record(ao, "$(P):$(R):STATE_BASE")
{
    field(DESC, "Decoded state without 6/7")
    field(FLNK, "$(P):$(R):STATE_FINAL")
}

# Final state: faults win, then ST_NOT_REACHED, then SP_NOT_REACHED
record(calcout, "$(P):$(R):STATE_FINAL")
{
    field(DESC, "Final state incl. NOT_REACHED")
    field(INPA, "$(P):$(R):STATE_BASE NPP NMS")
    field(INPB, "$(P):$(R):ST_NOT_REACHED NPP NMS")
    field(INPC, "$(P):$(R):SP_NOT_REACHED NPP NMS")
    field(CALC, "(A>=3&&A<=5)?A:(B?7:(C?6:A))")
    field(OUT,  "$(P):$(R):STATE_RB PP")
    field(OOPT, "Every Time")
}

record(mbbi, "$(P):$(R):STATE_RB")
{
    field(DESC, "State readback")
    field(SCAN, "Passive")
    field(ZRVL, "0")
    field(ZRST, "OFF")
    field(ONVL, "1")
    field(ONST, "ON")
    field(TWVL, "2")
    field(TWST, "STANDBY")
    field(THVL, "3")
    field(THST, "FAULT")
    field(THSV, "MAJOR")
    field(FRVL, "4")
    field(FRST, "EXT_INTLK")
    field(FRSV, "MAJOR")
    field(FVVL, "5")
    field(FVST, "CONN_FAULT")
    field(FVSV, "MAJOR")
    field(SXVL, "6")
    field(SXST, "SP_NOT_REACHED")
    field(SXSV, "MINOR")
    field(SVVL, "7")
    field(SVST, "ST_NOT_REACHED")
    field(SVSV, "MAJOR")
}

# ---------- state watchdog ----------
# Armed by the first state command after boot, so that a supply left running
# does not raise ST_NOT_REACHED just because STATE_SP boots as OFF.
record(calc, "$(P):$(R):ST_ARMED")
{
    field(DESC, "State command seen since boot")
    field(INPA, "$(P):$(R):STATE_SP NPP NMS")
    field(INPB, "$(P):$(R):ST_LAST NPP NMS")
    field(INPC, "$(P):$(R):ST_ARMED NPP NMS")
    field(CALC, "C||A!=B")
}

# Seconds the commanded state has not been reached. Faults do not count
# (they are shown as such); RESET has no target state.
record(calc, "$(P):$(R):ST_WDOG")
{
    field(DESC, "State unreached seconds")
    field(SCAN, "1 second")
    field(INPA, "$(P):$(R):STATE_SP NPP NMS")
    field(INPB, "$(P):$(R):ST_LAST NPP NMS")
    field(INPC, "$(P):$(R):STATE_BASE NPP NMS")
    field(INPD, "$(P):$(R):ST_WDOG NPP NMS")
    field(INPE, "$(P):$(R):ST_ARMED PP NMS")
    field(CALC, "(!E||(C>=3&&C<=5)||A!=B||A=3||A=C)?0:D+1")
    field(FLNK, "$(P):$(R):ST_NOT_REACHED")
}

record(calc, "$(P):$(R):ST_NOT_REACHED")
{
    field(DESC, "State not reached in time")
    field(INPA, "$(P):$(R):ST_WDOG NPP NMS")
    field(INPB, "$(P):$(R):SET_TIMEOUT_S NPP NMS")
    field(CALC, "A>=B")
    field(FLNK, "$(P):$(R):ST_LAST")
}

record(calc, "$(P):$(R):ST_LAST")
{
    field(DESC, "Previous state command")
    field(INPA, "$(P):$(R):STATE_SP NPP NMS")
    field(CALC, "A")
    field(PINI, "YES")
    field(FLNK, "$(P):$(R):STATE_FINAL")
}

# ---------- setpoint watchdog ----------
# Distance of the readback from the setpoint (from zero for a zero setpoint)
record(calc, "$(P):$(R):SP_ERR")
{
    field(DESC, "Setpoint error")
    field(INPA, "$(P):$(R):CURRENT_RB NPP NMS")
    field(INPB, "$(P):$(R):CURRENT_SP NPP NMS")
    field(INPC, "$(P):$(R):ZERO_TOLERANCE NPP NMS")
    field(CALC, "ABS(B)<=C?ABS(A):ABS(A-B)")
    field(EGU,  "A")
    field(PREC, "3")
}

# Seconds the setpoint has been unreached without progress. Only counts
# while the PS is ON. Restarts on progress and on a new setpoint.
record(calc, "$(P):$(R):SP_WDOG")
{
    field(DESC, "Setpoint unreached seconds")
    field(SCAN, "1 second")
    field(INPA, "$(P):$(R):SP_ERR PP NMS")
    field(INPB, "$(P):$(R):SP_WDOG NPP NMS")
    field(INPC, "$(P):$(R):ERR_LAST NPP NMS")
    field(INPD, "$(P):$(R):SET_TOLERANCE NPP NMS")
    field(INPE, "$(P):$(R):ZERO_TOLERANCE NPP NMS")
    field(INPF, "$(P):$(R):CURRENT_SP NPP NMS")
    field(INPG, "$(P):$(R):SP_LAST NPP NMS")
    field(INPH, "$(P):$(R):STATE_BASE NPP NMS")
    field(CALC, "D<=0||H!=1&&H<8?0:(A<=(ABS(F)<=E?E:D)?0:(F!=G||A<C-D/20?0:B+1))")
    field(FLNK, "$(P):$(R):SP_NOT_REACHED")
}

record(calc, "$(P):$(R):SP_NOT_REACHED")
{
    field(DESC, "Setpoint not reached in time")
    field(INPA, "$(P):$(R):SP_WDOG NPP NMS")
    field(INPB, "$(P):$(R):SET_TIMEOUT_S NPP NMS")
    field(CALC, "A>=B")
    field(FLNK, "$(P):$(R):SP_LAST")
}

record(calc, "$(P):$(R):SP_LAST")
{
    field(DESC, "Previous setpoint")
    field(INPA, "$(P):$(R):CURRENT_SP NPP NMS")
    field(CALC, "A")
    field(PINI, "YES")
    field(FLNK, "$(P):$(R):ERR_LAST")
}

record(calc, "$(P):$(R):ERR_LAST")
{
    field(DESC, "Previous setpoint error")
    field(INPA, "$(P):$(R):SP_ERR NPP NMS")
    field(CALC, "A")
    field(FLNK, "$(P):$(R):STATE_FINAL")
}
